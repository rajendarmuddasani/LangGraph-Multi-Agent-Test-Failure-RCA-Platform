# Application Settings
PROJECT_NAME="Multi-Agent RCA Platform"
VERSION="1.0.0"
ENVIRONMENT=development  # development, staging, production
HOST=0.0.0.0
PORT=8000

# Security (REQUIRED - Generate secure keys)
JWT_SECRET_KEY=change-this-to-a-secure-256-bit-key-in-production
JWT_ALGORITHM=RS256

# LLM API Keys (REQUIRED)
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Database
DATABASE_URL=postgresql+asyncpg://rca_user:rca_password@localhost:5432/rca_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional for local deployment
QDRANT_COLLECTION_NAME=rca_knowledge_base

# Object Storage (MinIO/S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_STDF=stdf-files
S3_BUCKET_REPORTS=rca-reports
S3_BUCKET_WAFER_MAPS=wafer-maps

# OAuth2/SSO (Optional - for production)
OAUTH2_CLIENT_ID=your-azure-ad-client-id
OAUTH2_CLIENT_SECRET=your-azure-ad-client-secret
OAUTH2_TENANT_ID=your-azure-ad-tenant-id

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Rate Limiting
API_RATE_LIMIT=100  # requests per minute
RCA_SUBMISSION_LIMIT_PER_DAY=50

# RCA Processing
MAX_CONCURRENT_RCAS=10
RCA_TIMEOUT_MINUTES=45
AGENT_EXECUTION_TIMEOUT=600

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@company.com
SMTP_PASSWORD=your-smtp-password
